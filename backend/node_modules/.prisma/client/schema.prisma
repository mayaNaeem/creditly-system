generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
  BANKER
}

enum AuctionStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum EventType {
  document_uploaded
  status_changed
  note_added
  auction_opened
  offer_submitted
  auction_closed
  winning_offer_selected
}

enum SyncStatus {
  SUCCESS
  FAILED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  bankId       String?
  accounts     Account[] @relation("ManagerAccounts")
}

model Account {
  id             String    @id @default(cuid())
  customerName   String
  email          String
  phone          String
  status         String
  managerId      String?
  manager        User?     @relation("ManagerAccounts", fields: [managerId], references: [id])
  lastActivity   DateTime?
  isHighActivity Boolean   @default(false)
  events         Event[]
  auctions       Auction[]
}

model Event {
  id            String      @id @default(cuid())
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id])
  type          EventType
  createdBy     String
  createdAt     DateTime    @default(now())
  syncStatus    SyncStatus?
  failureReason String?
}

model Auction {
  id            String        @id @default(cuid())
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id])
  status        AuctionStatus
  startDate     DateTime
  endDate       DateTime
  winnerOfferId String?
  offers        Offer[]
}

model Offer {
  id           String   @id @default(cuid())
  auctionId    String
  auction      Auction  @relation(fields: [auctionId], references: [id])
  bankId       String
  interestRate Float
  isWinner     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
